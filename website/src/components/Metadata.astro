---
import { defaultDescription, defaultTitle, pageMetadata, publicationDate } from '../lib/metadata';
import type { PageKind, PaperMetadata } from '../lib/metadata';

interface Props {
  title?: string;
  description?: string;
  kind?: PageKind;
  paper?: PaperMetadata;
  noindex?: boolean;
}
const { title = defaultTitle, description = defaultDescription, kind = 'home', paper, noindex = false } = Astro.props;
if (!Astro.site) throw new Error('Site metadata requires site in astro.config.mjs');
const root = new URL(import.meta.env.BASE_URL, Astro.site);
const meta = pageMetadata({ root, pathname: Astro.url.pathname, title, description, kind, paper });
---
<title>{title}</title>
<meta name="description" content={description} />
<meta name="author" content={meta.author} />
<meta name="robots" content={noindex ? "noindex, follow" : "index, follow, max-image-preview:large"} />
<link rel="canonical" href={meta.canonical} />
<link rel="sitemap" type="application/xml" href={new URL('sitemap.xml', root)} />
<meta property="og:site_name" content="emd — emotional damage" />
<meta property="og:locale" content="en_US" />
<meta property="og:type" content={meta.ogType} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={meta.canonical} />
<meta property="og:image" content={meta.image} />
<meta property="og:image:secure_url" content={meta.image} />
<meta property="og:image:type" content="image/png" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={meta.imageAlt} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={meta.image} />
<meta name="twitter:image:alt" content={meta.imageAlt} />
{paper && <Fragment>
  <meta property="article:author" content={`https://orcid.org/${paper.orcid}`} />
  <meta property="article:published_time" content={publicationDate(paper.date)} />
  <meta name="citation_title" content={paper.title} />
  <meta name="citation_author" content={paper.author} />
  <meta name="citation_publication_date" content={publicationDate(paper.date)} />
  <meta name="citation_pdf_url" content={new URL(paper.pdfPath ?? 'paper/emd.pdf', root)} />
  <meta name="citation_public_url" content={meta.canonical} />
  <meta name="citation_language" content="en" />
  {paper.doi && <meta name="citation_doi" content={paper.doi} />}
</Fragment>}
<script type="application/ld+json" is:inline set:html={meta.structuredData} />
